{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>securesign/renovate-config//org-inherited-config.json"
  ],
  "enabledManagers": ["dockerfile", "gomod", "tekton", "custom.regex"],
  "ignorePaths": [
    "Dockerfile",
    "Dockerfile.pubsub-emulator",
    "Dockerfile.trillian-log-server",
    "Dockerfile.trillian-log-signer",
    "docker-compose*.yml",
    "hack/tools/**",
    "release/**",
    ".github/workflows/**"
  ],
  "packageRules": [
    {
      "description": "Disable GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "enabled": false
    },
    {
      "description": "Disable docker-compose updates",
      "matchManagers": ["docker-compose"],
      "enabled": false
    },
    {
      "description": "Disable updates for upstream-only Docker images",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "golang",
        "gcr.io/google.com/cloudsdktool/google-cloud-cli",
        "ghcr.io/sigstore/scaffolding/trillian_log_server",
        "ghcr.io/sigstore/scaffolding/trillian_log_signer",
        "gcr.io/trillian-opensource-ci/db_server",
        "docker.io/valkey/valkey"
      ],
      "enabled": false
    }
  ]
}
